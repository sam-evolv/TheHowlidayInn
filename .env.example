# =====================================================================================
# Base configuration (non-secrets). Set in Netlify environment variables.
# =====================================================================================
WEB_BASE_URL=https://www.thehowlidayinn.ie
APP_URL=https://www.thehowlidayinn.ie
ADMIN_CRON_TOKEN=change_me_to_secure_random_string

# =====================================================================================
# DATABASE URL — Set in Netlify environment variables, not here.
# =====================================================================================
# DATABASE_URL=                                     # <— intentionally left blank / commented
# NEON_DATABASE_URL=                                # <— optional, set in Secrets, not here

# =====================================================================================
# Upload provider configuration
# =====================================================================================
UPLOADS_PROVIDER=cloudinary

# =====================================================================================
# Firebase (client-side) — only needed if you actually use Firebase Auth/UI
# These are PUBLIC keys; set in Netlify environment variables.
# =====================================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# =====================================================================================
# Stripe
# =====================================================================================
VITE_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# =====================================================================================
# Cloudinary (primary upload provider)
# Set real values in Netlify environment variables.
# =====================================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=dog_docs_unsigned

# =====================================================================================
# Stripe Webhook
# =====================================================================================
STRIPE_WEBHOOK_SECRET=

# =====================================================================================
# Server-side Firebase (if you later choose Firebase Storage server uploads)
# Set these in Netlify environment variables.
# =====================================================================================
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", "project_id":"", "private_key_id":"", "private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email":"", "client_id":"", "auth_uri":"https://accounts.google.com/o/oauth2/auth", "token_uri":"https://oauth2.googleapis.com/token", "auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs", "client_x509_cert_url":""}

# =====================================================================================
# Email / notifications
# =====================================================================================
RESEND_API_KEY=
BUSINESS_NOTIFY_EMAIL=admin@thehowlidayinn.ie

# =====================================================================================
# Admin list (comma-separated)
# =====================================================================================
ADMIN_EMAILS=admin@thehowlidayinn.ie,owner@thehowlidayinn.ie
